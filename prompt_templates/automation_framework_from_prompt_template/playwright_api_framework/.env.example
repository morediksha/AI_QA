# Environment Configuration Example
# Copy to .env and adjust values as needed

# Environment selection (dev, staging, production)
TEST_ENV=dev

# Logging
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# Retry Configuration
RETRY_ATTEMPTS=3
RETRY_DELAY=1
RETRY_BACKOFF=2

# Parallel Execution
MAX_WORKERS=4

# Reporting
REPORT_TYPE=html
# Options: html, json, allure

# API Timeout (in milliseconds)
API_TIMEOUT=10000

# Custom API base URL (optional - overrides environments.yaml)
# CUSTOM_BASE_URL=https://api.example.com
